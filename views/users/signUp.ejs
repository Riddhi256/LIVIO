<% layout('layouts/boilerPlate') -%>
<body>
<div class="row mt-3">
  <div class="col-8 offset-2">
    <h3>Sign-up for Livio</h3>
    <form action="/signup" method="post" class="needs-validation" novalidate>
      <div class="mb-2">
        <label for="Username" class="form-label">Username:</label><br />
        <input
          id="username"
          name="user[username]"
          type="text"
          class="form-control"
          required
        />
        <div class="valid-feedback">Looks good!</div>
        <div class="invalid-feedback">Please provide a username.</div>
      </div>

      <div class="mb-2">
        <label for="email" class="form-label">Email:</label><br />
        <input
          id="email"
          name="user[email]"
          type="email"
          class="form-control"
          required
        />
        </div>
        <div class="mb-2">
        <label for="password" class="form-label">Password:</label><br />
        <input
          id="password"
          name="user[password]"
          type="password"
          class="form-control"
          required
        />
      </div>
      <button type="submit" class="btn btn-dark add-btn">SignUp</button>
    </form>
  </div>
</div>
</body>
